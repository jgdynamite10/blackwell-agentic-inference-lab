# Pinned bootstrap configuration — copy to bootstrap.env on the instance and
# fill in the frozen values. bootstrap.env itself must never be committed if
# it ever contains non-public values (it should not). Tokens NEVER belong in
# this file, in script arguments, in logs, in Terraform state, or in Git —
# see fetch-model.sh for the credential-safe model acquisition workflow.
#
# PIN FREEZE POLICY (decision D-0012): the pilot runs with the candidate pins
# below; the FULL baseline runs only after the owner freezes the exact
# container digest, model revision, and digest manifest observed during the
# successful pilot. bootstrap.sh REFUSES to serve while any *_DIGEST value is
# unset or still a placeholder.

# --- serving container (vLLM BF16 baseline candidate) -----------------------
# UNVALIDATED CANDIDATE: vLLM v0.28.0 (CUDA 13.0 default image, 2026-08-26)
# has NOT been validated against this model. The model card's documented
# recipe uses vLLM v0.27.1. The pilot determines the frozen version; treat
# the value below as a starting candidate only, and expect to fall back to
# the model card's v0.27.1 recipe if v0.28.0 misbehaves.
VLLM_IMAGE="docker.io/vllm/vllm-openai:v0.28.0"
# Immutable digest of the image above, recorded at pilot time via
# `docker inspect --format '{{index .RepoDigests 0}}'`. REQUIRED before
# serving; the tag alone is never trusted for a measured run.
VLLM_IMAGE_DIGEST=""

# --- model artifact ----------------------------------------------------------
# BF16 baseline candidate (feasibility report §5; license OpenMDW-1.1).
MODEL_ARTIFACT="nvidia/NVIDIA-Nemotron-3.5-Lightning-30B-A3B-BF16"
# Exact artifact repository revision (commit) the weights are fetched at.
MODEL_REVISION=""
# Local directory the weights are downloaded into (fetch-model.sh).
MODEL_DIR="/opt/models/nemotron-3.5-lightning-30b-a3b-bf16"
# sha256sum-format digest manifest for every model file, produced by
# fetch-model.sh when the artifact is first downloaded and FROZEN with the
# baseline. bootstrap.sh verifies every file against it before serving ever
# starts.
MODEL_DIGEST_MANIFEST="/opt/models/nemotron-3.5-lightning-30b-a3b-bf16.sha256"

# --- host assumptions and pinned GPU-stack route ------------------------------
# Reproducible route (decision D-0013): the generic Ubuntu image is NOT
# assumed to contain an NVIDIA driver or the NVIDIA Container Toolkit.
# bootstrap.sh installs the exact pinned packages below idempotently, then
# requires a reboot and post-reboot re-run for validation.
REQUIRED_OS_ID="ubuntu"
REQUIRED_OS_VERSION="24.04"
# Exact pinned NVIDIA driver package (Ubuntu 24.04 archive). The R580 server
# branch is the candidate for CUDA 13.x on SM120; the exact package version
# is frozen after the pilot. REQUIRED before any apt install — never "latest".
NVIDIA_DRIVER_PACKAGE="nvidia-driver-580-server"
NVIDIA_DRIVER_PACKAGE_VERSION=""
# Exact pinned NVIDIA Container Toolkit package version (from NVIDIA's apt
# repository). REQUIRED before any apt install.
NVIDIA_CTK_PACKAGE_VERSION=""
# Pinned NVIDIA apt repository key URL and list entry (one-time install
# material). REQUIRED before bootstrap mutates the host.
NVIDIA_REPO_KEY_URL=""
NVIDIA_REPO_LIST=""
# Pinned Docker runtime package from Ubuntu 24.04. REQUIRED before any apt install.
DOCKER_PACKAGE="docker.io"
DOCKER_PACKAGE_VERSION=""
# Host driver minimums (validated after reboot):
MIN_DRIVER_BRANCH="580"
# Maximum CUDA version the DRIVER advertises (nvidia-smi banner). This is
# NOT the container's CUDA runtime version — that is validated separately
# via REQUIRED_CONTAINER_CUDA_VERSION.
DRIVER_MAX_CUDA_MAJOR="13"
# Actual CUDA runtime/toolkit version inside the serving container
# (observed via torch.version.cuda in the pinned image), e.g. "13.0".
REQUIRED_CONTAINER_CUDA_VERSION=""

# --- GPU probe image ----------------------------------------------------------
# Digest-pinned NVIDIA CUDA base image used ONLY to prove docker can reach the
# GPU through the NVIDIA runtime. bootstrap.sh runs nvidia-smi INSIDE this
# container (never a bare `true` probe) and verifies exactly one expected GPU.
GPU_PROBE_IMAGE="nvcr.io/nvidia/cuda:13.0.0-base-ubuntu24.04"
GPU_PROBE_IMAGE_DIGEST=""
# Substring matched against nvidia-smi's GPU name inside the probe container.
GPU_PROBE_EXPECTED_GPU="RTX PRO 6000"

# --- serving configuration ----------------------------------------------------
SERVED_MODEL_NAME="nemotron-3.5-lightning-30b-a3b-bf16"
SERVING_PORT="8000"
# BF16 baseline: no quantization flags. Additional engine flags are frozen
# after the pilot and recorded verbatim in every run manifest.
VLLM_EXTRA_ARGS="--dtype bfloat16"

# --- watchdog -----------------------------------------------------------------
# Idle minutes (no benchmark process) before the watchdog powers the host
# off. LIMITS RUNAWAY WORKLOAD ONLY: on Akamai a powered-off instance STILL
# BILLS — deletion (owner-approved) is the only spending stop.
WATCHDOG_IDLE_MINUTES="45"
