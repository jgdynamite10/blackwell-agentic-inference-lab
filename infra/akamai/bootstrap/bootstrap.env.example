# Pinned bootstrap configuration — copy to bootstrap.env on the instance and
# fill in the frozen values. bootstrap.env itself must never be committed if
# it ever contains non-public values (it should not).
#
# PIN FREEZE POLICY (decision D-0012): the pilot runs with the candidate pins
# below; the FULL baseline runs only after the owner freezes the exact
# container digest, model revision, and digest manifest observed during the
# successful pilot. bootstrap.sh REFUSES to serve while any *_DIGEST value is
# unset or still a placeholder.

# --- serving container (vLLM BF16 baseline candidate) -----------------------
# Candidate release: vLLM v0.28.0 (CUDA 13.0 default image, 2026-08-26).
VLLM_IMAGE="docker.io/vllm/vllm-openai:v0.28.0"
# Immutable digest of the image above, recorded at pilot time via
# `docker inspect --format '{{index .RepoDigests 0}}'`. REQUIRED before
# serving; the tag alone is never trusted for a measured run.
VLLM_IMAGE_DIGEST=""

# --- model artifact ----------------------------------------------------------
# BF16 baseline candidate (feasibility report §5; license OpenMDW-1.1).
MODEL_ARTIFACT="nvidia/NVIDIA-Nemotron-3.5-Lightning-30B-A3B-BF16"
# Exact artifact repository revision (commit) the weights are fetched at.
MODEL_REVISION=""
# Local directory the weights are downloaded into.
MODEL_DIR="/opt/models/nemotron-3.5-lightning-30b-a3b-bf16"
# sha256sum-format digest manifest for every model file, produced when the
# artifact is first downloaded and FROZEN with the baseline. bootstrap.sh
# verifies every file against it before serving ever starts.
MODEL_DIGEST_MANIFEST="/opt/models/nemotron-3.5-lightning-30b-a3b-bf16.sha256"

# --- host assumptions (checked, not assumed silently) ------------------------
# Ubuntu 24.04 LTS (the terraform image pin), NVIDIA driver R580+ branch and
# CUDA 13.x for vLLM v0.28.0 CUDA-13 images on SM120.
REQUIRED_OS_ID="ubuntu"
REQUIRED_OS_VERSION="24.04"
MIN_DRIVER_BRANCH="580"
REQUIRED_CUDA_MAJOR="13"

# --- serving configuration ----------------------------------------------------
SERVED_MODEL_NAME="nemotron-3.5-lightning-30b-a3b-bf16"
SERVING_PORT="8000"
# BF16 baseline: no quantization flags. Additional engine flags are frozen
# after the pilot and recorded verbatim in every run manifest.
VLLM_EXTRA_ARGS="--dtype bfloat16"

# --- watchdog -----------------------------------------------------------------
# Idle minutes (no benchmark process) before the watchdog powers the host
# off. LIMITS RUNAWAY WORKLOAD ONLY: on Akamai a powered-off instance STILL
# BILLS — deletion (owner-approved) is the only spending stop.
WATCHDOG_IDLE_MINUTES="45"
