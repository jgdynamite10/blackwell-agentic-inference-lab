# D-0046 vLLM NVFP4 cell pins. This is not the frozen BF16 baseline.
# bootstrap.sh reads this file only when BWLAB_BOOTSTRAP_EXAMPLE is
# bootstrap.nvfp4.env.example. The BF16 file stays bootstrap.env.example.
# Copy this file to bootstrap.env on the NVFP4 host. No token belongs here.
#
# The aggregate sha256:d2450b268476489d75f0c75cb12461f9b02fb031d9751b3263aadca6c26edb04
# is checked by the cell after fetch-model.sh writes the per-file manifest.
# --dtype bfloat16 is omitted so the checkpoint quantization is the precision
# under test. The model card's H100 humming and Spark speculative recipes
# are not used.
#
# --- serving container (same vLLM 0.27.1 digest as the BF16 cell) ----------
# Selected candidate: vLLM v0.27.1. Primary sources: the NVIDIA model card
# for NVIDIA-Nemotron-3.5-Lightning-30B-A3B-BF16 names
# `vllm/vllm-openai:v0.27.1`, and official vLLM recipes state 0.27.1 or
# newer. The v0.27.1 Dockerfile defaults to CUDA 13.0.3 with SM120 (12.0)
# in TORCH_CUDA_ARCH_LIST. v0.28.0 is newer and has additional SM12x work,
# but was not chosen merely for newness; it is not the model card's named
# recipe. UNVALIDATED on this project's target GPU.
VLLM_IMAGE="docker.io/vllm/vllm-openai:v0.27.1"
# Multi-platform index digest (Docker Hub registry manifest list, retrieved
# 2026-09-07; verification: registry-1.docker.io /v2/ manifests API,
# Docker-Content-Digest header; no image layers downloaded).
VLLM_IMAGE_INDEX_DIGEST="sha256:0a51ea5b4ae2dc5d81890e5173f54203d2a3ae0cfffe51b8fd2afd4391bfd967"
# Exact linux/amd64 manifest digest used by the GPU host. bootstrap.sh
# pulls this digest, never the mutable tag.
VLLM_IMAGE_DIGEST="sha256:c2f3b1b964e47809b722b5e75b61b1e7b39a50f70388cf2bf2418f16a9f31da2"

# --- model artifact ----------------------------------------------------------
# NVFP4 checkpoint. Public repo HEAD was still this revision on 2026-10-15.
MODEL_ARTIFACT="nvidia/NVIDIA-Nemotron-3.5-Lightning-30B-A3B-NVFP4"
# Hugging Face commit confirmed 2026-10-15.
MODEL_REVISION="bee7596271d1495f6992ae224aefde4410e816b8"
# Local directory the weights are downloaded into (fetch-model.sh).
MODEL_DIR="/opt/models/nemotron-3.5-lightning-30b-a3b-nvfp4"
# sha256sum-format digest manifest written by fetch-model.sh during the
# authorized live download, then verified by bootstrap.sh before serving.
MODEL_DIGEST_MANIFEST="/opt/models/nemotron-3.5-lightning-30b-a3b-nvfp4.sha256"

# --- host assumptions and pinned GPU-stack route ------------------------------
# Reproducible route (decision D-0013): the generic Ubuntu image is NOT
# assumed to contain an NVIDIA driver or the NVIDIA Container Toolkit.
# bootstrap.sh installs the exact pinned packages below idempotently, then
# requires a reboot and post-reboot re-run for validation.
REQUIRED_OS_ID="ubuntu"
REQUIRED_OS_VERSION="24.04"
# Ubuntu 24.04 restricted/updates OPEN kernel-module metapackage
# (packages.ubuntu.com noble-updates and archive.ubuntu.com noble-updates
# Packages index, retrieved 2026-09-15). Blackwell requires NVIDIA open
# kernel modules; the proprietary nvidia-driver-580-server package is
# rejected. Live verification after reboot still required: exact package
# version, Dual MIT/GPL module license, one RTX PRO 6000.
NVIDIA_DRIVER_PACKAGE="nvidia-driver-580-server-open"
NVIDIA_DRIVER_PACKAGE_VERSION="580.178.04-0ubuntu0.24.04.1"
# NVIDIA Container Toolkit production pin from the official install guide
# and the amd64 Packages index (retrieved 2026-09-07). All four toolkit
# packages must match this version.
NVIDIA_CTK_PACKAGE_VERSION="1.20.0-1"
# Official NVIDIA Container Toolkit apt key URL plus the SHA-256 of the
# armored key bytes (retrieved 2026-09-07 from
# https://nvidia.github.io/libnvidia-container/gpgkey). bootstrap.sh
# downloads to a temp file, verifies this digest, then installs atomically.
# The SHA-256 is a public checksum of the official armored key, not a secret.
NVIDIA_REPO_KEY_URL="https://nvidia.github.io/libnvidia-container/gpgkey"
NVIDIA_REPO_KEY_SHA256="sha256:c880576d6cf75a48e5027a871bac70fd0421ab07d2b55f30877b21f1c87959c9"
NVIDIA_REPO_LIST="deb [signed-by=/usr/share/keyrings/nvidia-container-toolkit-keyring.gpg] https://nvidia.github.io/libnvidia-container/stable/deb/amd64 /"
# Ubuntu 24.04 universe/security docker.io package (packages.ubuntu.com
# noble, retrieved 2026-09-07).
DOCKER_PACKAGE="docker.io"
DOCKER_PACKAGE_VERSION="29.1.3-0ubuntu3~24.04.2"
# Host driver minimums (validated after reboot):
MIN_DRIVER_BRANCH="580"
# Maximum CUDA version the DRIVER advertises (nvidia-smi banner). This is
# NOT the container's CUDA runtime version — that is validated separately
# via REQUIRED_CONTAINER_CUDA_VERSION.
DRIVER_MAX_CUDA_MAJOR="13"
# Candidate container CUDA runtime from the v0.27.1 Dockerfile
# CUDA_VERSION=13.0.3 (torch.version.cuda is expected to report 13.0).
# Exact string still confirmed live inside the digest-pinned image.
REQUIRED_CONTAINER_CUDA_VERSION="13.0"

# --- GPU probe image ----------------------------------------------------------
# Digest-pinned NVIDIA CUDA base image used ONLY to prove docker can reach
# the GPU through the NVIDIA runtime. bootstrap.sh runs nvidia-smi INSIDE
# this container (never a bare `true` probe) and verifies exactly one
# expected GPU. Tag + index + linux/amd64 digest recorded from public NGC
# and Docker Hub manifest APIs (retrieved 2026-09-07; identical on both
# registries; no image layers downloaded).
GPU_PROBE_IMAGE="nvcr.io/nvidia/cuda:13.0.0-base-ubuntu24.04"
GPU_PROBE_IMAGE_INDEX_DIGEST="sha256:6e43a6b02e5f16e4a715953be8b29c40acbe84aed11a61357ef0fc899967fbd9"
GPU_PROBE_IMAGE_DIGEST="sha256:cf5ab24c3f5040a0ea5931658874c2158e606bf740f006809aa4bb9d3334016b"
# Substring matched against nvidia-smi's GPU name inside the probe container.
GPU_PROBE_EXPECTED_GPU="RTX PRO 6000"

# --- serving configuration ----------------------------------------------------
SERVED_MODEL_NAME="nemotron-3.5-lightning-30b-a3b-nvfp4"
SERVING_PORT="8000"
# Same flags as the BF16 cell except --dtype bfloat16 is omitted. Official
# NVIDIA Nemotron 3.5 Lightning / vLLM 0.27.1 parser trio
# (--reasoning-parser nemotron_v3 --tool-call-parser qwen3_coder
# --enable-auto-tool-choice). Unvalidated on the target GPU. The model's
# bundled chat template is used; no custom template is invented.
VLLM_EXTRA_ARGS="--max-num-seqs 128 --enable-prefix-caching --async-scheduling --mamba-backend flashinfer --mamba-ssm-cache-dtype float16 --enable-mamba-cache-stochastic-rounding --mamba-cache-philox-rounds 5 --reasoning-parser nemotron_v3 --tool-call-parser qwen3_coder --enable-auto-tool-choice"

# --- watchdog -----------------------------------------------------------------
# Idle minutes (no benchmark process) before the watchdog powers the host
# off. LIMITS RUNAWAY WORKLOAD ONLY: on Akamai a powered-off instance STILL
# BILLS — deletion (owner-approved) is the only spending stop. Normalized
# economic cost still uses the $3/hour planning rate even when compute is
# provided without a direct charge.
WATCHDOG_IDLE_MINUTES="45"
