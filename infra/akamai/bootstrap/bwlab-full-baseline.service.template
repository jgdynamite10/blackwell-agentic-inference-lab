[Unit]
Description=Blackwell lab full-baseline (owner-started; survives SSH disconnect)
Documentation=file:///opt/bwlab-lab/infra/akamai/README.md
After=docker.service
Requires=docker.service

[Service]
Type=simple
# Owner fills EnvironmentFile with the approved run tag, label, config path,
# and digest-bearing approval phrase. The file is host-private (0600) and
# never belongs in Git.
EnvironmentFile=-/etc/bwlab/full-baseline.env
WorkingDirectory=/opt/bwlab-lab
# Slice is attached by controlled-resource.sh for controlled-resource cells.
# Do not set CPUQuota/MemoryMax here — that would apply a second envelope.
ExecStart=/opt/bwlab-lab/.venv/bin/python -m blackwell_lab.cloud.cli full-baseline \
  --run-tag ${BWLAB_RUN_TAG} \
  --run-label ${BWLAB_RUN_LABEL} \
  --config ${BWLAB_CONFIG} \
  --approve ${BWLAB_APPROVE}
Restart=no
TimeoutStopSec=120
# Loss of the owner's SSH session must not terminate an active cell.
KillMode=process

[Install]
WantedBy=multi-user.target
