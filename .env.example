# ---------------------------------------------------------------------------
# Blackwell Agentic Inference Lab — environment variable reference
#
# This file documents variable NAMES only. It must never contain values.
# Copy to `.env` (which is gitignored) and fill in values locally, or export
# the variables in your shell / CI secret store.
#
# .gitignore excludes `.env`, but .gitignore is not a security boundary:
# never commit a filled-in copy of this file under any name.
# ---------------------------------------------------------------------------

# --- Results privacy (required for any benchmark execution) ----------------
# Absolute path to the PRIVATE directory where genuine benchmark results are
# written. Must resolve OUTSIDE this repository; the benchmark runner refuses
# to start otherwise. Example shape: /data/lab-results (do not use a path
# inside the repo checkout).
LAB_RESULTS_DIR=

# --- Akamai Cloud (Linode API) ---------------------------------------------
# Personal access token, read-only scope for feasibility checks.
# Created at: Akamai Cloud Manager -> API Tokens.
LINODE_TOKEN=

# --- Google Cloud -----------------------------------------------------------
# Path to a service-account key file with read-only roles (e.g. roles/viewer,
# roles/compute.viewer), stored OUTSIDE the repository. Prefer workload
# identity or `gcloud auth application-default login` where possible.
GOOGLE_APPLICATION_CREDENTIALS=
# Project ID used for quota and availability checks (an identifier the owner
# considers non-sensitive; still never committed in docs or results).
GOOGLE_CLOUD_PROJECT=

# --- AWS ---------------------------------------------------------------------
# Access key for a read-only IAM identity (e.g. ViewOnlyAccess plus
# pricing:Get*). Prefer AWS SSO / assumed roles over long-lived keys.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_DEFAULT_REGION=

# --- NVIDIA NGC / NIM --------------------------------------------------------
# NGC Personal API key. Required only to download Production Branch (PB)
# models / NIM containers; feature-branch NIM containers may not require it.
NGC_API_KEY=

# --- Hugging Face ------------------------------------------------------------
# Token used to download model artifacts (only needed if an artifact is gated;
# the Nemotron 3.5 Lightning weights are OpenMDW-1.1 licensed).
HF_TOKEN=

# --- Telemetry (later phases) -----------------------------------------------
# Credentials for pushing metrics to a PRIVATE monitoring stack, if used.
PROMETHEUS_REMOTE_WRITE_URL=
GRAFANA_API_TOKEN=
