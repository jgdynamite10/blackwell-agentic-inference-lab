# ---------------------------------------------------------------------------
# Blackwell Agentic Inference Lab — environment variable reference
#
# This file documents variable NAMES and safe descriptions only. It must never
# contain real values, account identifiers, account-specific endpoints, tokens,
# or credential file paths from a real machine.
#
# These variables are for the OWNER'S LOCAL, AUTHENTICATED ENVIRONMENT only.
# The hosted Cloud Agent must never request, receive, store, or use any of
# these credentials (AGENTS.md, section 3).
#
# Copy to `.env` (which is gitignored) locally, or export the variables in
# your local shell. .gitignore excludes `.env`, but .gitignore is a
# defense-in-depth control, not the privacy boundary: never commit a filled-in
# copy of this file under any name, and never paste values into chat, issues,
# pull requests, or CI configuration.
# ---------------------------------------------------------------------------

# --- Results privacy (required for any real benchmark run) ------------------
# Absolute path to the PRIVATE directory where genuine benchmark results are
# written. Must resolve OUTSIDE this repository checkout; the benchmark runner
# fails closed if this is unset for a real run and refuses to start if the
# path (after resolving symlinks) is inside the repository.
LAB_RESULTS_DIR=

# --- Akamai Cloud (Linode API) ---------------------------------------------
# Personal access token with READ-ONLY scope, used locally for feasibility
# checks (scripts/preflight/check_akamai.py).
LINODE_TOKEN=

# --- Google Cloud ------------------------------------------------------------
# Path (on the local machine) to a service-account key file with read-only
# roles (e.g. roles/viewer, roles/compute.viewer), stored OUTSIDE the
# repository. Prefer `gcloud auth application-default login` or workload
# identity where possible.
GOOGLE_APPLICATION_CREDENTIALS=
# Project ID used locally for quota and availability checks. Treat as
# sensitive: never commit it or include it in logs, results, or reports.
GOOGLE_CLOUD_PROJECT=

# --- AWS ---------------------------------------------------------------------
# Access key for a READ-ONLY IAM identity (e.g. ViewOnlyAccess plus
# pricing:Get*). Prefer AWS SSO / short-lived assumed roles over long-lived
# keys. Used locally for scripts/preflight/check_aws.py.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_DEFAULT_REGION=

# --- NVIDIA NGC / NIM --------------------------------------------------------
# NGC Personal API key, used locally in later authorized phases. Required only
# to download Production Branch (PB) models / NIM containers.
NGC_API_KEY=

# --- Hugging Face ------------------------------------------------------------
# Token used locally to download model artifacts in later authorized phases
# (only needed if an artifact is gated).
HF_TOKEN=

# --- Telemetry (later phases) -----------------------------------------------
# Credentials for pushing metrics to a PRIVATE monitoring stack, if used.
PROMETHEUS_REMOTE_WRITE_URL=
GRAFANA_API_TOKEN=
