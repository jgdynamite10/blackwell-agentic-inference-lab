{
  "dns-failures-001": {
    "evidence_schema_version": "1.0.0",
    "diagnosis_hypotheses": [
      {
        "id": "badger-queue-outage",
        "about": [
          {
            "kind": "service",
            "id": "badger-queue",
            "scope": "$task"
          }
        ],
        "claim": {
          "text": "Hypothesis: badger-queue is in an outage.",
          "support_all_of": [
            {
              "subject": {
                "kind": "service",
                "id": "badger-queue",
                "scope": "$task"
              },
              "condition": {
                "name": "availability",
                "state": "outage"
              },
              "polarity": "affirmed",
              "witness_type": "log",
              "role": "condition"
            }
          ]
        }
      },
      {
        "id": "dns-search-domain-typo-cfg-5150",
        "about": [
          {
            "kind": "configuration",
            "id": "cfg-5150",
            "scope": "$task"
          }
        ],
        "claim": {
          "text": "Hypothesis: configuration cfg-5150 contains a DNS search-domain typo.",
          "support_all_of": [
            {
              "subject": {
                "kind": "configuration",
                "id": "cfg-5150",
                "scope": "$task"
              },
              "condition": {
                "name": "dns.search_domain",
                "state": "typo"
              },
              "polarity": "affirmed",
              "witness_type": "log",
              "role": "condition"
            }
          ]
        }
      },
      {
        "id": "network-firewall-block",
        "about": [
          {
            "kind": "network-path",
            "id": "DNS",
            "scope": "$task"
          }
        ],
        "claim": {
          "text": "Hypothesis: a firewall is blocking the relevant DNS network path.",
          "support_all_of": [
            {
              "subject": {
                "kind": "network-path",
                "id": "DNS",
                "scope": "$task"
              },
              "condition": {
                "name": "firewall_action",
                "state": "blocked"
              },
              "polarity": "affirmed",
              "witness_type": "log",
              "role": "condition"
            }
          ]
        }
      }
    ]
  },
