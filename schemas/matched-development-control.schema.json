{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jgdynamite10/blackwell-agentic-inference-lab/schemas/matched-development-control.schema.json",
  "title": "Matched P1 development control",
  "description": "Content-free record that a fully completed, non-stopped, verified P1 development run is the same-session control for P2C development (decision D-0027). Digests authenticate the P1 config, result, receipt, terminal session event, ledger, resource identity, and frozen precision. The record must not contain private paths, credentials, provider resource ids, addresses, prompts, completions, reasoning, or task bodies.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "run_tag",
    "run_label",
    "stage",
    "candidate_id",
    "canonical_commit",
    "region",
    "config_sha256",
    "result_sha256",
    "evaluator_version",
    "catalog_digest",
    "schedule_digest",
    "resource_identity_sha256",
    "ledger_sha256",
    "receipt_sha256",
    "terminal_event_sha256",
    "model_artifact",
    "model_revision",
    "model_artifact_sha256",
    "served_model_name",
    "engine",
    "engine_version",
    "precision",
    "container_digest",
    "workload_version",
    "temperature",
    "top_p",
    "seed",
    "max_tokens",
    "reasoning_mode",
    "completed",
    "verified",
    "stopped",
    "terminal_event",
    "failure_record",
    "identity_sha256"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0.0" },
    "kind": { "type": "string", "const": "matched-p1-development-control" },
    "run_tag": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{3,40}$" },
    "run_label": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,40}$" },
    "stage": { "type": "string", "const": "development" },
    "candidate_id": { "type": "string", "const": "P1" },
    "canonical_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "region": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,40}$" },
    "config_sha256": { "$ref": "#/$defs/hex_digest" },
    "result_sha256": { "$ref": "#/$defs/hex_digest" },
    "evaluator_version": { "type": "string", "minLength": 1 },
    "catalog_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "schedule_digest": { "$ref": "#/$defs/hex_digest" },
    "resource_identity_sha256": { "$ref": "#/$defs/hex_digest" },
    "ledger_sha256": { "$ref": "#/$defs/hex_digest" },
    "receipt_sha256": { "$ref": "#/$defs/hex_digest" },
    "terminal_event_sha256": { "$ref": "#/$defs/hex_digest" },
    "model_artifact": { "type": "string", "minLength": 1 },
    "model_revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "model_artifact_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "served_model_name": { "type": "string", "minLength": 1 },
    "engine": { "type": "string", "minLength": 1 },
    "engine_version": { "type": "string", "minLength": 1 },
    "precision": { "type": "string", "minLength": 1 },
    "container_digest": { "type": "string", "minLength": 1 },
    "workload_version": { "type": "string", "minLength": 1 },
    "temperature": { "type": "number" },
    "top_p": { "type": "number" },
    "seed": { "type": "integer" },
    "max_tokens": { "type": "integer" },
    "reasoning_mode": { "type": "boolean" },
    "completed": { "type": "boolean" },
    "verified": { "type": "boolean" },
    "stopped": { "type": "boolean" },
    "terminal_event": { "type": "string", "minLength": 1 },
    "failure_record": { "type": "boolean" },
    "identity_sha256": { "$ref": "#/$defs/hex_digest" }
  },
  "$defs": {
    "hex_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
