{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jgdynamite10/blackwell-agentic-inference-lab/schemas/sealed-materialization-request.schema.json",
  "title": "Sealed qualification-task materialization request",
  "description": "Content-free request that the owner approval phrase binds for one offline materialization of sealed qualification tasks (decision D-0025). It names the frozen commit, the implementation digest, the production generator and its seed and occurrence rule, the source and predicted output aggregates, counts, set identities and per-stage distribution summaries. It must not contain task bodies, task identifiers, scenario identifiers, private filenames, or paths. SHA-256 digests provide integrity, not confidentiality.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request_version",
    "kind",
    "controller_commit",
    "implementation_digest",
    "algorithm",
    "source",
    "distribution",
    "output",
    "materialization_request_digest"
  ],
  "properties": {
    "request_version": { "type": "string", "const": "1.0.0" },
    "kind": { "type": "string", "const": "sealed-qualification-task-materialization" },
    "controller_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "implementation_digest": { "$ref": "#/$defs/digest" },
    "algorithm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generator",
        "seed",
        "seed_rule",
        "occurrence_rule",
        "payload_schema_version",
        "payload_kind"
      ],
      "properties": {
        "generator": {
          "type": "string",
          "const": "blackwell_lab.workload.sampling.generate_task_instances"
        },
        "seed": { "type": "integer", "minimum": 0 },
        "seed_rule": { "type": "string", "minLength": 1, "maxLength": 512 },
        "occurrence_rule": { "type": "string", "const": "task-id-sorted-per-template-counter" },
        "payload_schema_version": { "type": "string", "const": "1.0.0" },
        "payload_kind": { "type": "string", "const": "sealed-qualification-task" }
      }
    },
    "source": { "$ref": "#/$defs/stage_summary" },
    "output": { "$ref": "#/$defs/stage_summary" },
    "distribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["development", "holdout"],
      "properties": {
        "development": { "$ref": "#/$defs/distribution_summary" },
        "holdout": { "$ref": "#/$defs/distribution_summary" }
      }
    },
    "materialization_request_digest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "stage_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "development_task_count",
        "holdout_task_count",
        "development_aggregate_digest",
        "holdout_aggregate_digest",
        "set_identity",
        "ordering"
      ],
      "properties": {
        "development_task_count": { "type": "integer", "const": 20 },
        "holdout_task_count": { "type": "integer", "const": 20 },
        "development_aggregate_digest": { "$ref": "#/$defs/digest" },
        "holdout_aggregate_digest": { "$ref": "#/$defs/digest" },
        "set_identity": { "$ref": "#/$defs/digest" },
        "ordering": { "type": "string", "const": "task-id-sorted" }
      }
    },
    "distribution_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["template_count", "counts", "digest"],
      "properties": {
        "template_count": { "type": "integer", "minimum": 1, "maximum": 20 },
        "counts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": { "type": "integer", "minimum": 1, "maximum": 20 }
        },
        "digest": { "$ref": "#/$defs/digest" }
      }
    }
  }
}
