{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jgdynamite10/blackwell-agentic-inference-lab/schemas/benchmark-result.schema.json",
  "title": "Benchmark Result",
  "description": "Aggregated results for one run (one repetition of one experimental cell), linked to its run manifest. Genuine results live outside the Git working tree and are never committed to the repository; only synthetic examples (is_synthetic_example=true) may be committed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "is_synthetic_example",
    "manifest_ref",
    "tasks",
    "latency_ms",
    "throughput",
    "gpu",
    "errors",
    "slo",
    "economics"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "run_id": {
      "type": "string",
      "description": "Must match the run_id of the associated manifest.",
      "minLength": 8
    },
    "is_synthetic_example": {
      "type": "boolean",
      "description": "True only for synthetic example files committed to the repository."
    },
    "manifest_ref": {
      "type": "string",
      "description": "Relative filename of the run manifest this result belongs to."
    },
    "tasks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attempted", "succeeded", "failed", "timed_out", "success_rate"],
      "properties": {
        "attempted": { "type": "integer", "minimum": 0 },
        "succeeded": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "timed_out": { "type": "integer", "minimum": 0 },
        "success_rate": { "type": "number", "minimum": 0, "maximum": 1 },
        "mean_quality_score": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }
      }
    },
    "latency_ms": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_completion",
        "time_to_first_token",
        "inter_token",
        "queue_time",
        "model_serving_time",
        "tool_execution_time"
      ],
      "properties": {
        "task_completion": { "$ref": "#/$defs/latency_summary" },
        "time_to_first_token": { "$ref": "#/$defs/latency_summary" },
        "inter_token": { "$ref": "#/$defs/latency_summary" },
        "queue_time": { "$ref": "#/$defs/latency_summary" },
        "model_serving_time": { "$ref": "#/$defs/latency_summary" },
        "tool_execution_time": { "$ref": "#/$defs/latency_summary" }
      }
    },
    "throughput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["output_tokens_per_second", "successful_tasks_per_gpu_hour"],
      "properties": {
        "output_tokens_per_second": { "type": "number", "minimum": 0 },
        "total_output_tokens": { "type": "integer", "minimum": 0 },
        "successful_tasks_per_gpu_hour": {
          "type": ["number", "null"],
          "minimum": 0,
          "description": "Null when the run consumed zero GPU-hours (mock execution): the measure is undefined, never fabricated."
        }
      }
    },
    "gpu": {
      "type": "object",
      "additionalProperties": false,
      "required": ["telemetry_available"],
      "description": "GPU telemetry. When telemetry_available is false (e.g. mock/CPU execution), only the explicit unavailable_reason may be present — metric fields must be absent, never zero-filled or fabricated.",
      "properties": {
        "telemetry_available": {
          "type": "boolean",
          "description": "True only when genuine GPU telemetry (DCGM) was collected for this run."
        },
        "unavailable_reason": {
          "type": "string",
          "minLength": 1,
          "description": "Why telemetry is unavailable (required when telemetry_available is false)."
        },
        "utilization_mean_pct": { "type": "number", "minimum": 0, "maximum": 100 },
        "utilization_p95_pct": { "type": "number", "minimum": 0, "maximum": 100 },
        "memory_peak_gib": { "type": "number", "minimum": 0 },
        "power_mean_watts": { "type": "number", "minimum": 0 },
        "energy_joules": { "type": "number", "minimum": 0 },
        "energy_per_successful_task_joules": { "type": ["number", "null"], "minimum": 0 }
      },
      "oneOf": [
        {
          "properties": { "telemetry_available": { "const": true } },
          "required": ["telemetry_available", "utilization_mean_pct", "memory_peak_gib", "energy_joules"],
          "not": { "required": ["unavailable_reason"] }
        },
        {
          "properties": { "telemetry_available": { "const": false } },
          "required": ["telemetry_available", "unavailable_reason"],
          "propertyNames": { "enum": ["telemetry_available", "unavailable_reason"] }
        }
      ]
    },
    "errors": {
      "type": "object",
      "additionalProperties": false,
      "required": ["error_rate", "timeout_rate"],
      "properties": {
        "error_rate": { "type": "number", "minimum": 0, "maximum": 1 },
        "timeout_rate": { "type": "number", "minimum": 0, "maximum": 1 },
        "taxonomy": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 },
          "description": "Error-category counts (e.g. endpoint_5xx, malformed_tool_call, agent_crash)."
        }
      }
    },
    "slo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["latency_target_ms", "quality_threshold", "slo_attaining_tasks", "slo_attaining_throughput_per_gpu_hour"],
      "properties": {
        "latency_target_ms": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "End-to-end task latency target for this profile."
        },
        "ttft_target_ms": { "type": ["number", "null"], "exclusiveMinimum": 0 },
        "quality_threshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Minimum evaluator score for a task to count as SLO-attaining."
        },
        "slo_attaining_tasks": { "type": "integer", "minimum": 0 },
        "slo_attaining_throughput_per_gpu_hour": {
          "type": ["number", "null"],
          "minimum": 0,
          "description": "Correctly completed tasks per GPU-hour satisfying both the quality threshold and the latency target. Null when the run consumed zero GPU-hours (mock execution)."
        }
      }
    },
    "economics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gpu_hours", "list_price_usd_per_hour", "cost_per_successful_task_usd"],
      "properties": {
        "gpu_hours": { "type": "number", "minimum": 0 },
        "list_price_usd_per_hour": { "type": "number", "minimum": 0 },
        "cost_per_successful_task_usd": { "type": ["number", "null"], "minimum": 0 },
        "cost_basis_note": {
          "type": "string",
          "description": "What the price basis includes/excludes (taxes, discounts, storage reported separately)."
        }
      }
    },
    "notes": {
      "type": "string",
      "description": "Free-form observations. Must contain no sensitive infrastructure metadata."
    }
  },
  "$defs": {
    "latency_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mean", "p50", "p90", "p95", "p99", "count"],
      "description": "Per-repetition latency summary with explicit tail suppression: p95 is null below 200 observations and p99 is null below 1,000 (nearest-rank method; see methodology/measurement-contract.md §3 and decision D-0009). An empty series (count 0) reports every statistic as null — values are never fabricated. The conditionals below make suppression machine-checkable.",
      "properties": {
        "mean": { "type": ["number", "null"], "minimum": 0 },
        "p50": { "type": ["number", "null"], "minimum": 0 },
        "p90": { "type": ["number", "null"], "minimum": 0 },
        "p95": {
          "type": ["number", "null"],
          "minimum": 0,
          "description": "Null (suppressed) when count < 200."
        },
        "p99": {
          "type": ["number", "null"],
          "minimum": 0,
          "description": "Null (suppressed) when count < 1000."
        },
        "min": { "type": ["number", "null"], "minimum": 0 },
        "max": { "type": ["number", "null"], "minimum": 0 },
        "count": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of observations in this repetition's sample; determines which percentiles may be reported."
        }
      },
      "allOf": [
        {
          "if": { "properties": { "count": { "const": 0 } } },
          "then": {
            "properties": {
              "mean": { "type": "null" },
              "p50": { "type": "null" },
              "p90": { "type": "null" },
              "min": { "type": "null" },
              "max": { "type": "null" }
            }
          }
        },
        {
          "if": { "properties": { "count": { "minimum": 1 } } },
          "then": {
            "properties": {
              "mean": { "type": "number" },
              "p50": { "type": "number" },
              "p90": { "type": "number" }
            }
          }
        },
        {
          "if": { "properties": { "count": { "maximum": 199 } } },
          "then": { "properties": { "p95": { "type": "null" } } },
          "else": { "properties": { "p95": { "type": "number" } } }
        },
        {
          "if": { "properties": { "count": { "maximum": 999 } } },
          "then": { "properties": { "p99": { "type": "null" } } },
          "else": { "properties": { "p99": { "type": "number" } } }
        }
      ]
    }
  }
}
